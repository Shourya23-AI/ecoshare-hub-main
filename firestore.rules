rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rules can't import js/firebase-config.js, so this literal can't be
    // fully unified with the client's ADMIN_EMAIL constant the way the JS
    // files now are (auth.js / admin.js / admin-dashboard.js all import
    // ADMIN_EMAIL from firebase-config.js instead of hardcoding it).
    // This is the ONLY place in these rules the email is spelled out —
    // every other check below calls isPermanentAdminEmail(...) or isAdmin()
    // instead of repeating the string, so changing the admin account only
    // means editing it here AND in firebase-config.js's ADMIN_EMAIL.
    function isPermanentAdminEmail(email) {
      return email == 'shadow@ecoshare.com';
    }

    // Helper function to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && (
        isPermanentAdminEmail(request.auth.token.email) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------- users/{userId} ----------
    // Everyone signed in can read profiles (names/tiers shown on cards,
    // the leaderboard, chat headers, etc). A user can only create/update
    // their OWN document (needed for sign-up, and for the itemsShared /
    // itemsClaimed / unlockedTiers counters main.js and impact.js write
    // as someone posts, claims, and earns medals) — and even then they
    // can't touch their own admin-relevant fields. Admins can manage any
    // user doc, but can never demote or delete the permanent admin account.
    //
    // ANTI-CHEAT: itemsShared/tier/unlockedTiers are "donation" stats that
    // directly gate Diamond-tier perks (priority claiming, certificates),
    // so a self-update can't just be allowed to set them to anything —
    // that's an instant, free tier upgrade from devtools. Self-writes to
    // these fields are only allowed when they're consistent with the
    // app's own logic: itemsShared can only step up by exactly 1 per write
    // (one posted item = one donation, per main.js), tier must always be
    // whatever getCurrentTier() would derive from the post-write
    // itemsShared count (mirrored here since rules can't call JS), and
    // unlockedTiers may only grow, one justified tier name at a time.
    // itemsClaimed is capped to a sane per-write increment so it can't be
    // used to fabricate a huge stat jump either. None of this applies to
    // admin writes below, which stay fully trusted.
    function tierForShared(shared) {
      return shared >= 100 ? 'Diamond'
        : shared >= 40 ? 'Platinum'
        : shared >= 25 ? 'Gold'
        : shared >= 15 ? 'Silver'
        : shared >= 5 ? 'Bronze'
        : null;
    }

    function unlockedTiersJustified(shared, tiers) {
      return (!('Bronze' in tiers) || shared >= 5) &&
        (!('Silver' in tiers) || shared >= 15) &&
        (!('Gold' in tiers) || shared >= 25) &&
        (!('Platinum' in tiers) || shared >= 40) &&
        (!('Diamond' in tiers) || shared >= 100);
    }

    function selfStatWritesValid(existing, incoming) {
      let changedKeys = incoming.diff(existing).affectedKeys();
      let newShared = incoming.get('itemsShared', existing.get('itemsShared', 0));

      return
        (!changedKeys.hasAny(['itemsShared']) ||
          incoming.itemsShared == existing.get('itemsShared', 0) + 1) &&
        (!changedKeys.hasAny(['tier']) ||
          incoming.tier == tierForShared(newShared)) &&
        (!changedKeys.hasAny(['unlockedTiers']) ||
          (incoming.unlockedTiers.hasAll(existing.get('unlockedTiers', [])) &&
            incoming.unlockedTiers.hasOnly(['Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond']) &&
            unlockedTiersJustified(newShared, incoming.unlockedTiers))) &&
        (!changedKeys.hasAny(['itemsClaimed']) ||
          (incoming.itemsClaimed > existing.get('itemsClaimed', 0) &&
            incoming.itemsClaimed <= existing.get('itemsClaimed', 0) + 20));
    }

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('itemsShared', 0) == 0 &&
        request.resource.data.get('itemsClaimed', 0) == 0 &&
        request.resource.data.get('tier', null) == null &&
        request.resource.data.get('unlockedTiers', []).size() == 0;

      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'banned']) &&
          selfStatWritesValid(resource.data, request.resource.data)) ||
        (isAdmin() &&
          !(isPermanentAdminEmail(resource.data.email) &&
            (request.resource.data.role != resource.data.role || request.resource.data.email != resource.data.email)))
      );

      allow delete: if isAdmin() && !isPermanentAdminEmail(resource.data.email);
    }

    // ---------- items/{itemId} ----------
    // Listings are readable by anyone signed in. Only the poster can
    // create a listing under their own uid — and a banned user can't post
    // at all. Claiming an item updates fields on someone else's listing
    // (status/claimedBy/quantity/claims), so update is open to any
    // signed-in, non-banned user — the app's own transaction logic
    // (main.js) is what enforces "don't claim your own item" and "don't
    // oversell quantity". Only the owner or an admin can delete.
    function isBanned() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }

    // A "claim" update is one where claimedBy is being set to whoever is
    // making the request (as opposed to a poster editing their own
    // listing, an admin action, or an unclaim/reopen, all of which leave
    // claimedBy untouched or null it out). Only claim updates are subject
    // to the 15-minute Gold/Platinum/Diamond priority window below.
    function isClaimAttempt() {
      return request.resource.data.claimedBy == request.auth.uid &&
        resource.data.get('claimedBy', null) != request.auth.uid;
    }

    // True once the item's priority window has expired (or it never had
    // one, e.g. an older listing posted before this feature existed) — at
    // that point the item is first-come-first-served for everyone.
    function priorityWindowOver() {
      return !('priorityUntil' in resource.data) || request.time > resource.data.priorityUntil;
    }

    // Gold/Platinum/Diamond members can claim during the priority window;
    // tier is kept in sync on users/{uid}.tier by tiers.js's
    // syncUserTierField() every time itemsShared changes.
    function isPriorityMember() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tier', null) in
        ['Gold', 'Platinum', 'Diamond'];
    }

    match /items/{itemId} {
      // Public read so "Continue as guest" browsing works without signing in.
      allow read: if true;

      allow create: if request.auth != null && !isBanned() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null && !isBanned() &&
        (!isClaimAttempt() || priorityWindowOver() || isPriorityMember());

      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------- chats/{chatId} ----------
    // A chat thread is private to exactly the two people in its
    // `participants` array (the item's owner and claimer). Nobody else
    // can read, create, or update it. Banned users can't start new chats,
    // but existing threads stay readable so the other party isn't cut off
    // mid-conversation.
    //
    // BUGFIX: getOrCreateChat() (js/chat.js) always does a getDoc() FIRST
    // to check whether a thread already exists before creating one. On a
    // document that doesn't exist yet, `resource` is null, so the old rule
    // (`request.auth.uid in resource.data.participants`) blew up trying to
    // read `.data` off null and denied the read outright — which meant the
    // very first chat between two people could never even be checked for,
    // let alone created. This is why "starting a chat" appeared broken.
    // The `resource == null` clause below lets that existence check
    // through; it can't leak anything because a nonexistent document has
    // no data to leak.
    match /chats/{chatId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants);

      allow create: if request.auth != null && !isBanned() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow delete: if false;

      // ---------- chats/{chatId}/messages/{messageId} ----------
      // Only the two chat participants can read or send messages, and a
      // message's senderId must match whoever is actually signed in.
      // Banned users can still read history but can't send new messages.
      // Message bodies are end-to-end encrypted client-side (js/e2ee.js) —
      // this rule only ever sees ciphertext (`cipher`/`iv` fields), never
      // plaintext, and doesn't need to know or care about that.
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null && !isBanned() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow update, delete: if false;
      }
    }

    // ---------- certificates/{certId} ----------
    // Donation-milestone certificates (Bronze/Silver/Gold/Platinum/Diamond).
    // Readable by anyone signed in (leaderboard + impact stats count
    // these). A user can unlock their own certificate as they cross a
    // threshold; an admin can also create/revoke certificates for ANY
    // user (admin.html's manual unlock/revoke buttons, for beta-testing
    // tiers without grinding out real donations first).
    match /certificates/{certId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- bannedIPs/{ip} ----------
    // Best-effort IP ban list (see js/ip-guard.js for why this is a
    // deterrent, not a hard guarantee, in a client-only app with no
    // backend server — Firestore rules can't see the caller's real IP).
    // Readable by any signed-in user so the client can self-check on
    // login/page-load; only an admin can add or remove an entry.
    match /bannedIPs/{ip} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- admins/{userId} ----------
    // auth.js auto-grants the permanent admin account its own admins/{uid}
    // doc on sign-up/login. Beyond that, only an existing admin can promote
    // or revoke admin rights for someone else (admin.html's "Make Admin" /
    // "Revoke Admin" buttons) — nobody else can write here.
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        (request.auth.uid == userId && isPermanentAdminEmail(request.auth.token.email)) ||
        isAdmin()
      );
    }

    // Poster claim notifications: only the recipient (the poster) can ever
    // read their own notifications. Any signed-in user can create one
    // (that's the claimer notifying the poster), but only for someone else
    // — never for themselves — and it must start unread. After creation,
    // only the recipient can touch it, and only to flip it to read.
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientId;

      allow create: if request.auth != null &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.claimedByUid == request.auth.uid &&
        request.resource.data.read == false;

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.recipientId &&
        request.resource.data.recipientId == resource.data.recipientId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }
  }
}
